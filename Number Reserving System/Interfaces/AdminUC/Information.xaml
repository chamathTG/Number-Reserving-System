<UserControl x:Class="Number_Reserving_System.Interfaces.AdminUC.Information"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Number_Reserving_System.Interfaces.AdminUC"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             
             Width="1500"
             Height="620"
             Background="White"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!--Table-->
        <Grid Grid.Row="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!--Information Table-->
            <DataGrid Grid.Row="1"
                      Grid.Column="1"
                      x:Name="UserInfoTable"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      AutoGenerateColumns="True"/>

        </Grid>

        <!--Search-->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="45"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!--Search Box-->
            <TextBox Grid.Column="1"
                     x:Name="SearchTB"
                     FontSize="15"
                     FontFamily="pack://application:,,,/assets/fonts/#Alan Sans"
                     Padding="10"
                     Width="400"
                     Height="50"
                     Foreground="Black"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="ID Number"
                     materialDesign:HintAssist.Foreground="Black"
                     materialDesign:TextFieldAssist.HasClearButton="True"
                     materialDesign:TextFieldAssist.ClearButtonSize="19"/>

            <!--Search Button-->
            <Button Grid.Column="3"
                    x:Name="SearchBttn"
                    Width="200"
                    Height="45"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Search  |  "
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <materialDesign:PackIcon Kind="Magnify"
                                             Width="23"
                                             Height="23"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!--Reset Button-->
            <Button Grid.Column="5"
                    x:Name="ResetBttn"
                    Width="65"
                    Height="45"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0">

                <StackPanel Orientation="Horizontal">

                    <materialDesign:PackIcon Kind="Undo"
                                             Width="23"
                                             Height="23"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

    </Grid>
    
</UserControl>
