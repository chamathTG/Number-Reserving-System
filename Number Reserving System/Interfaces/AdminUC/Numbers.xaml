<UserControl x:Class="Number_Reserving_System.Interfaces.AdminUC.Numbers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Number_Reserving_System.Interfaces.AdminUC"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             
             Width="1500"
             Height="620"
             Background="White"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!--Numbers-->
        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="230"/>
                <RowDefinition/>
                <RowDefinition Height="230"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--Now number-->
            <Border Grid.Row="1"
                    Width="450"
                    Background="Brown"
                    BorderBrush="White"
                    BorderThickness="2"
                    CornerRadius="15">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="80"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="1"
                               Text="Ongoing Number"
                               FontSize="40"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <TextBlock Grid.Row="2"
                               Text="------------"
                               FontSize="60"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <TextBlock Grid.Row="3"
                               x:Name="NowNumberTxt"
                               Text="0000"
                               FontSize="65"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                </Grid>

            </Border>

            <!--Upcoming number-->
            <Grid Grid.Row="3">

                <Border Grid.Row="1"
                        Width="450"
                        Background="Brown"
                        BorderBrush="White"
                        BorderThickness="2"
                        CornerRadius="15">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="80"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="1"
                                   Text="Upcoming Number"
                                   FontSize="40"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                        <TextBlock Grid.Row="2"
                                   Text="------------"
                                   FontSize="60"
                                   Foreground="White"
                                   VerticalAlignment = "Center"
                                   HorizontalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                        <TextBlock Grid.Row="3"
                                   x:Name="ComingNumberTxt"
                                   Text="0000"
                                   FontSize="65"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

        <!--Table-->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!--Number Table-->
            <DataGrid Grid.Row="1"
                      Grid.Column="1"
                      x:Name="UserInfoTable"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      AutoGenerateColumns="True"/>

        </Grid>

        <!--Buttons-->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="65"/>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--Add User Button-->
            <Button Grid.Row="1"
                    x:Name="NumResetBttn"
                    Width="200"
                    Height="45"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Reset Number  |  "
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <materialDesign:PackIcon Kind="Autorenew"
                                             Width="23"
                                             Height="23"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!--Edit User Button-->
            <Button Grid.Row="2"
                    x:Name="DelNumBttn"
                    Width="200"
                    Height="45"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Delete Number  |  "
                               FontSize="18"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <materialDesign:PackIcon Kind="DeleteEmptyOutline"
                                             Width="23"
                                             Height="23"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

    </Grid>

</UserControl>
    