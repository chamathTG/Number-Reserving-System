<UserControl x:Class="Number_Reserving_System.Interfaces.AdminUC.Users"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Number_Reserving_System.Interfaces.AdminUC"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             
             Width="1500"
             Height="620"
             Background="White"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!--Users Table-->
        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Row="1"
                      Grid.Column="1"
                      x:Name="UsersTable"
                      Style="{StaticResource MaterialDesignDataGrid}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      SelectionChanged="UsersTable_SelectionChanged"/>
            
        </Grid>

        <!--Detail filling fieled-->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--Text-->
                <TextBlock Grid.Row="1"
                           Text="Add / Edit Logins"
                           FontSize="25"
                           Padding="50,0,0,0"
                           FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                <!--Role-->
                <TextBox Grid.Row="3"
                         x:Name="RoleTB"
                         FontSize="15"
                         MaxLength="1"
                         FontFamily="pack://application:,,,/assets/fonts/#Alan Sans"
                         Padding="10"
                         Width="300"
                         Height="50"
                         Foreground="Black"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Role"
                         materialDesign:HintAssist.Foreground="Black"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         materialDesign:TextFieldAssist.ClearButtonSize="19"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                         PreviewTextInput="RoleTB_PreviewTextInput"
                         PreviewKeyDown="RoleTB_PreviewKeyDown"/>

                <!--Username-->
                <TextBox Grid.Row="4"
                         x:Name="UsernameTB"
                         FontSize="15"
                         MaxLength="15"
                         FontFamily="pack://application:,,,/assets/fonts/#Alan Sans"
                         Padding="10"
                         Width="300"
                         Height="50"
                         Foreground="Black"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Username"
                         materialDesign:HintAssist.Foreground="Black"
                         materialDesign:TextFieldAssist.HasClearButton="True"
                         materialDesign:TextFieldAssist.ClearButtonSize="19"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                         PreviewTextInput="UsernameTB_PreviewTextInput"
                         PreviewKeyDown="UsernameTB_PreviewKeyDown"/>

                <!--Pssword-->
                <PasswordBox Grid.Row="5"
                             x:Name="PassPB"
                             FontSize="15"
                             MaxLength="15"
                             FontFamily="pack://application:,,,/assets/fonts/#Alan Sans"
                             Padding="10"
                             Width="300"
                             Height="45"
                             Foreground="Black"
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                             materialDesign:HintAssist.Hint="Password"
                             materialDesign:HintAssist.Foreground="Black"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:TextFieldAssist.ClearButtonSize="19"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                             PreviewTextInput="PassPB_PreviewTextInput"
                             PreviewKeyDown="PassPB_PreviewKeyDown"/>

            </Grid>

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--Text-->
                <TextBlock Grid.Row="1"
                           Text="Update the PIN"
                           FontSize="25"
                           Padding="50,0,0,0"
                           FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                <!--Pin-->
                <PasswordBox Grid.Row="3"
                             x:Name="PinPB"
                             FontSize="15"
                             FontFamily="pack://application:,,,/assets/fonts/#Alan Sans"
                             Padding="10"
                             MaxLength="5"
                             Width="300"
                             Height="45"
                             Foreground="Black"
                             Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                             materialDesign:HintAssist.Hint="New Security Pin"
                             materialDesign:HintAssist.Foreground="Black"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                             PreviewTextInput="PinPB_PreviewTextInput"
                             PreviewKeyDown="PinPB_PreviewKeyDown"/>

            </Grid>

        </Grid>

        <!--Buttons-->
        <Grid Grid.Column="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--Add User Button-->
                <Button Grid.Row="1"
                        x:Name="AddUserBttn"
                        Width="200"
                        Height="45"
                        Background="Brown"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="AddUserBttn_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Add User  |  "
                                   FontSize="18"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                        <materialDesign:PackIcon Kind="AccountPlusOutline"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!--Edit User Button-->
                <Button Grid.Row="2"
                        x:Name="EditUserBttn"
                        Width="200"
                        Height="45"
                        Background="Brown"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="EditUserBttn_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Edit User  |  "
                                   FontSize="18"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                        <materialDesign:PackIcon Kind="AccountEditOutline"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

                <!--Delete User Button-->
                <Button Grid.Row="3"
                        x:Name="DelUserBttn"
                        Width="200"
                        Height="45"
                        Background="Brown"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="DelUserBttn_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Delete User  |  "
                                   FontSize="18"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                        <materialDesign:PackIcon Kind="AccountRemoveOutline"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

            <Grid Grid.Row="2">

                <!--Edit Pin Button-->
                <Button Grid.Row="1"
                        x:Name="EditPinBttn"
                        Width="200"
                        Height="45"
                        Background="Brown"
                        materialDesign:ElevationAssist.Elevation="Dp0"
                        Click="EditPinBttn_Click">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="Update PIN  |  "
                                   FontSize="18"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                        <materialDesign:PackIcon Kind="PencilLock"
                                                 Width="23"
                                                 Height="23"
                                                 Foreground="White"
                                                 VerticalAlignment="Center"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Grid>

    </Grid>
    
</UserControl>
