<Window x:Class="Number_Reserving_System.Interfaces.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Number_Reserving_System.Interfaces"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        
        Style="{StaticResource MaterialDesignWindow}"
       
        d:DesignWidth="1920"
        d:DesignHeight="1080"
        
        Title="NR System"
        Height="700"
        Width="1000"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Background="Brown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <!--User Button-->
            <Button Grid.Column="1"
                    x:Name="UsersBttn"
                    Width="260"
                    Height="100"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0"
                    Click="UsersBttn_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Users  |  "
                               FontSize="25"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <materialDesign:PackIcon Kind="AccountKeyOutline"
                                             Width="35"
                                             Height="35"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!--Number Button-->
            <Button Grid.Column="2"
                    x:Name="NumbersBttn"
                    Width="260"
                    Height="100"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0"
                    Click="NumbersBttn_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Numbers  |  "
                               FontSize="25"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <materialDesign:PackIcon Kind="Counter"
                                             Width="35"
                                             Height="35"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!--Information Button-->
            <Button Grid.Column="3"
                    x:Name="InfoBtn"
                    Width="260"
                    Height="100"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp0"
                    Click="InfoBtn_Click">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Information  |  "
                               FontSize="25"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontFamily="pack://application:,,,/assets/fonts/#Fredoka SemiBold"/>

                    <materialDesign:PackIcon Kind="AccountDetailsOutline"
                                             Width="35"
                                             Height="35"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

            <!--Logout Button-->
            <Button Grid.Column="5"
                    x:Name="LogoutBtn"
                    Width="100"
                    Height="80"
                    Background="Brown"
                    materialDesign:ElevationAssist.Elevation="Dp1"
                    Click="LogoutBtn_Click">

                <StackPanel>

                    <materialDesign:PackIcon Kind="Logout"
                                             Width="35"
                                             Height="35"
                                             Foreground="White"
                                             VerticalAlignment="Center"/>

                </StackPanel>

            </Button>

        </Grid>

        <ContentControl x:Name="MainContent"
                        Grid.Row="1"/>

    </Grid>
    
</Window>
